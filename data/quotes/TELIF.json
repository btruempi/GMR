"fundamentals":{"name":"Telescope Innovations Corp.","exchange":"OTC Markets OTCQB","currency":"USD","marketCap":26584942,"previousClose":0.3,"open":0.314,"bid":0.325,"ask":0.3289,"dayLow":0.314,"dayHigh":0.329,"volume":31116,"avgVolume":185765,"fiftyTwoWeekLow":0.21,"fiftyTwoWeekHigh":0.76928,"beta":1.333,"trailingPE":null,"forwardPE":null,"trailingEps":-0.04,"forwardEps":null,"priceToBook":10.977819,"sharesOutstanding":80805298,"dividendRate":null,"dividendYield":null,"exDividendDate":null,"targetMeanPrice":null,"earningsDate":null,"sector":"Healthcare","industry":"Biotechnology","website":"https://telescopeinnovations.com","employees":null,"summary":"Telescope Innovations Corp., a chemical technology company, develops manufacturing processes and tools for the pharmaceutical and chemical industry in the United States and Canada. It offers DIRECTINJECT-LCTM, a hardware and software ecosystem that enables direct sampling and analysis of chemical reactions. It also provides intellectual property and contract research services. It serves pharmaceutical, critical minerals, and chemical industries. Telescope Innovations Corp. has a research collaboration with Pfizer Inc; and Standard Lithium Ltd. to develop a method for producing high-purity lithium sulfide. Telescope Innovations Corp. has a development and collaboration agreement with AGI Group's Synthesis, Digitization, and Automation program to develop the next generation of automation- and AI-ready chemical reactor technology. Telescope Innovations Corp. is based in Vancouver, Canada."}}